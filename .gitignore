# Secrets / machine-local auth
agent/auth.json
agent/models.json
agent/**/.env
agent/**/.env.*
!agent/**/.env.example

# Session/runtime state
agent/sessions/
agent/missions/
agent/run-history.jsonl
agent/**/*.log
agent/**/*.tmp
agent/**/*.cache

# Machine-local runtime state; regenerated by pi, not config worth versioning
agent/mcp-cache.json
agent/mcp-npx-cache.json
agent/models-store.json
agent/provider-failover-state.json
agent/claude-bridge.json

# Installed package/vendor caches; restore from agent/settings.json packages
agent/bin/
agent/npm/
agent/git/

# Dependency installs inside custom extensions
agent/extensions/**/node_modules/

# OS/editor junk
.DS_Store
Thumbs.db
*.swp
*~
